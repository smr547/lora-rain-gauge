collab 1
title "Rain Gauge — AO Collaboration"

# Active Objects
# ao BucketReedSwitch
# ao RadioDIO0
# ao TippingBucket
# ao Radio
# ao Control

ao TippingBucket
ao Control
ao Radio

isr BucketReedSwitch
isr RadioDIO0

timer SleepTimer "Periodic; inactivity interval"

collaboration SleepTimer Control
  SleepTimer -> Control
    CONSIDER_SLEEPING
end

timer RadioTxTimer "One-shot; transmission timeout"

collaboration RadioTxTimer Radio
  RadioTxTimer -> Radio
    RADIO_TX_TIMEOUT
end

# BucketReedSwitch is triggered by the falling edge of the rain gauge reed switch
# (this GPIO signal is normally high as a result of a 10kOhm pullup resister and 100nF filtering capacitor)
# This event is signals the start of a possible rain gauge bucket tip event

collaboration BucketReedSwitch TippingBucket
  BucketReedSwitch -> TippingBucket
    BUCKET_SWITCH_CLOSING
end

# The TippingBucket primary purpose is to identify bone-fide tips of the rain gauge bucket, rejecting any false
# signals that may be induced by RF interference, swith bounce or other noise sources. Once a genuine bucket tip 
# has been identified the event is signalled to the Control
# As a secondary function, the TippingBucket must inform the Control when it is busy processing a potential bucket tip. 
# This will prevent the Control from putting the processor to sleep in the middle of a tipping event.
# Finally the TippingBucket can report error conditions to the Control by sending a RAIN_BUCKET_FAULT signal (for example
# if the bucket fails to reset after a tip)

collaboration TippingBucket Control
  TippingBucket -> Control
    BUCKET_TIPPED
    BUCKET_BUSY
    BUCKET_IDLE
    BUCKET_FAULT
  
  Control -> TippingBucket 
    BUCKET_SWITCH_CLOSING    # if Control finds that the processor has been woken by a reed switch closure
                             # it is obliged to tell the TippingBucket so it can complete signal processing on the reed switch
end

# The Radio is responsible for sending data packets to the base station via LoRa packet radio as requested by 
# the Control. As with all critical active objects the Radio must inform the Control of its busy status
# to ensure that the processor is not put to sleep prematurely.

collaboration Control Radio
  Control -> Radio
    SEND_HEALTH_REPORT   # Control directs the sending of a periodic gauge health report via radio
    SEND_RAIN_REPORT     # In response to a tipping bucket event, Control directs the sending of a rain report via radio

  Radio -> Control
    RADIO_BUSY
    RADIO_IDLE
end

# The Radio initiates the Lora packet tranmission which then completes asynchronously. A hardware interrupt is used
# to indicate the completion of the transmission
#

collaboration Radio RadioDIO0
  RadioDIO0 -> Radio
    RADIO_TX_DONE
end

