   <file name="control.cpp">
    <text>#include &quot;qpcpp.hpp&quot; // QP/C++ framework API
#include &quot;bsp.hpp&quot;   // Board Support Package interface
#include &quot;events.hpp&quot;





using namespace QP;

// ask QM to declare the Control  class ----------------------------------------
$declare${AOs::Control}

// opaque pointer to the Control active object --------------------------------
$define${AOs::AO_Control}


// busyFlag manipulation

static constexpr std::uint8_t BUCKET_BUSY = 1U &lt;&lt; 0;
static constexpr std::uint8_t RADIO_BUSY = 1U &lt;&lt; 1;

// ask QM to define the Control class (including the state machine) -----------
$define${AOs::Control}</text>
