 <directory name=".">
  <directory name="generated">
   <file name="bsp.hpp">
    <text>#define BSP_HPP

#include &lt;Arduino.h&gt;
#include &quot;qpcpp.hpp&quot;


static constexpr uint8_t BUCKET_PIN = 25;

// a very simple Board Support Package (BSP) -------------------------------
class BSP {
public:
    enum { TICKS_PER_SEC = 100 }; // numer of clock ticks in a second
    static void init(void);
    static void terminate(int16_t);
    static void start(void);
};

enum RainGaugeSignals {
    TIMEOUT_SIG = QP::Q_USER_SIG, // offset the first signal
    BUCKET_SWITCH_CLOSING_SIG, //  sent by button ISR to AO_Button for debounce
    BUCKET_SWITCH_OPEN_SIG,
    BUCKET_SWITCH_CLOSED_SIG,
    FAULT_TIMEOUT_SIG,
    CONTINUE_SIG,
    TIPPING_BUCKET_IDLE_SIG,
    TIPPING_BUCKET_BUSY_SIG,
    MAX_SIG
};

#ifdef Q_SPY
enum UserQSRecords {
    QS_USER_BUTTON = QP::QS_USER,
   // QS_BUTTON_BOUNCE,
    QS_BOOT,
    QS_ASSERT,
    QS_ERROR,
    QS_DIAGNOSTIC
};
#endif

// active object(s) used in this application -------------------------------
$declare${AOs::AO_TippingBucket}
#endif // BSP_HPP</text>
   </file>
   <file name="tippingBucket.cpp">
    <text>#include &quot;qpcpp.hpp&quot; // QP/C++ framework API
#include &quot;bsp.hpp&quot;   // Board Support Package interface

// reusable event instances associated with the tipping bucket
static QP::QEvt const continueEvt{CONTINUE_SIG, 0U, 0U};
static QP::QEvt const timeoutEvt{TIMEOUT_SIG, 0U, 0U};
static QP::QEvt const switchClosingEvt{BUCKET_SWITCH_CLOSING_SIG, 0U, 0U};
static QP::QEvt const switchOpenEvt{BUCKET_SWITCH_OPEN_SIG, 0U, 0U};
static QP::QEvt const switchClosedEvt{BUCKET_SWITCH_CLOSED_SIG, 0U, 0U};
static QP::QEvt const faultTimeoutEvt{FAULT_TIMEOUT_SIG, 0U, 0U};

using namespace QP;

// ask QM to declare the Button class ----------------------------------------
$declare${AOs::TippingBucket}

// opaque pointer to the Button active object --------------------------------
$define${AOs::AO_TippingBucket}

// ask QM to define the Button class (including the state machine) -----------
$define${AOs::TippingBucket}</text>
   </file>
   <file name="control.cpp">
    <text>#include &quot;qpcpp.hpp&quot; // QP/C++ framework API
#include &quot;bsp.hpp&quot;   // Board Support Package interface



// reusable event instances associated with  the Control AO

static QP::QEvt const bucketBusyEvt{TIPPING_BUCKET_BUSY, 0U, 0U};
static QP::QEvt const bucketIdleEvt{TIPPING_BUCKET_IDLE, 0U, 0U};

using namespace QP;

// ask QM to declare the Control  class ----------------------------------------
$declare${AOs::Control}

// opaque pointer to the Control active object --------------------------------
$define${AOs::AO_Control}


// busyFlag manipulation

static constexpr std::uint8_t TIPPING_BUCKET_BUSY = 1U &lt;&lt; 0;
static constexpr std::uint8_t RADIO_BUSY          = 1U &lt;&lt; 1;

// ask QM to define the Control class (including the state machine) -----------
$define${AOs::Control}</text>
