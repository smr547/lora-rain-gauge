   <file name="tippingBucket.cpp">
    <text>#include &quot;qpcpp.hpp&quot; // QP/C++ framework API
#include &quot;bsp.hpp&quot;   // Board Support Package interface

// reusable event instances associated with the tipping bucket
static QP::QEvt const continueEvt{CONTINUE_SIG, 0U, 0U};
static QP::QEvt const timeoutEvt{TIMEOUT_SIG, 0U, 0U};
static QP::QEvt const switchClosingEvt{BUCKET_SWITCH_CLOSING_SIG, 0U, 0U};
static QP::QEvt const switchOpenEvt{BUCKET_SWITCH_OPEN_SIG, 0U, 0U};
static QP::QEvt const switchClosedEvt{BUCKET_SWITCH_CLOSED_SIG, 0U, 0U};
static QP::QEvt const faultTimeoutEvt{FAULT_TIMEOUT_SIG, 0U, 0U};


using namespace QP;

// ask QM to declare the Button class ----------------------------------------
$declare${AOs::TippingBucket}

// opaque pointer to the Button active object --------------------------------
$define${AOs::AO_TippingBucket}

// ask QM to define the Button class (including the state machine) -----------
$define${AOs::TippingBucket}</text>
