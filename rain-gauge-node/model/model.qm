  <class name="Control" superclass="qpcpp::QActive">
   <attribute name="instance" type="Control" visibility="0x00" properties="0x01"/>
   <attribute name="m_busyMask" type="std::uint8_t" visibility="0x02" properties="0x00">
    <documentation>bit:         7 6 5 4 3 2 1 0
             0 0 0 0 0 0 R T
                         │ │
                         │ └─ TippingBucketAO busy
                         └─── RadioAO busy</documentation>
   </attribute>
   <operation name="Control" type="" visibility="0x00" properties="0x01">
    <documentation>Control constructor</documentation>
    <code>: QActive(Q_STATE_CAST(&amp;Control::initial))</code>
   </operation>
   <statechart properties="0x00">
    <initial target="../1">
     <action brief="initial">m_busyMask = 0U;</action>
     <initial_glyph conn="70,3,5,0,3,6">
      <action box="0,-2,10,2"/>
     </initial_glyph>
    </initial>
    <state name="Running">
     <tran trig="TIPPING_BUCKET_IDLE">
      <action>M_busyMask &amp;= ~TIPPING_BUCKET_BUSY;</action>
      <tran_glyph conn="55,18,3,-1,28">
       <action box="0,-2,20,2"/>
      </tran_glyph>
     </tran>
     <tran trig="TIPPING_BUCKET_BUSY">
      <action>m_busyMask |= TIPPING_BUCKET_BUSY;</action>
      <tran_glyph conn="55,22,3,-1,28,-1">
       <action box="0,-2,21,2"/>
      </tran_glyph>
     </tran>
     <state_glyph node="55,9,34,23"/>
    </state>
    <state_diagram size="147,88"/>
