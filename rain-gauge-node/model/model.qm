   <file name="bsp.hpp">
    <text>#define BSP_HPP

#include &lt;Arduino.h&gt;
#include &quot;qpcpp.hpp&quot;


static constexpr uint8_t BUCKET_PIN = 25;

// a very simple Board Support Package (BSP) -------------------------------
class BSP {
public:
    enum { TICKS_PER_SEC = 100 }; // numer of clock ticks in a second
    static void init(void);
    static void terminate(int16_t);
    static void start(void)
    static void goToSleep(void);
};

enum RainGaugeSignals {
    TIMEOUT_SIG = QP::Q_USER_SIG, // offset the first signal
    BUCKET_SWITCH_CLOSING_SIG, //  sent by button ISR to AO_Button for debounce
    BUCKET_SWITCH_OPEN_SIG,
    BUCKET_SWITCH_CLOSED_SIG,
    FAULT_TIMEOUT_SIG,
    CONTINUE_SIG,
    TIPPING_BUCKET_IDLE_SIG,
    TIPPING_BUCKET_BUSY_SIG,
    MAX_SIG
};

#ifdef Q_SPY
enum UserQSRecords {
    QS_USER_BUTTON = QP::QS_USER,
   // QS_BUTTON_BOUNCE,
    QS_BOOT,
    QS_ASSERT,
    QS_ERROR,
    QS_DIAGNOSTIC
};
#endif

// active object(s) used in this application -------------------------------
$declare${AOs::AO_TippingBucket}
#endif // BSP_HPP</text>
